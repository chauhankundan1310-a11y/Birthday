rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Birthday surprises are public-by-link: anyone with the unguessable ID can read.
    match /birthdays/{id} {
      allow read: if true;
      // Anyone may create a surprise (no accounts). Creation only — no edits/deletes.
      allow create: if request.resource.data.keys().hasAll([
          'relationship', 'themeId', 'name', 'senderName', 'date',
          'heading', 'intro', 'photos', 'music', 'messages', 'animations'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 8;
      allow update, delete: if false;
    }
  }
}
