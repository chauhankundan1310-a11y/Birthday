rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos/audio uploaded for birthday surprises are public-by-link.
    match /birthdays/{id}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*');
    }
  }
}
